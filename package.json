{
  "version": "1.0.2",
  "license": "AGPL-3.0-or-later",
  "name": "@constl/interface",
  "author": "Julien Jean Malard-Adam",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./automatisations": "./dist/automatisations.js",
    "./bds": "./dist/bds.js",
    "./importateur": "./dist/importateur.js",
    "./licences": "./dist/licences.js",
    "./mots-clefs": "./dist/mots-clefs.js",
    "./nuées": "./dist/nuées.js",
    "./objets": "./dist/objets.js",
    "./projets": "./dist/projets.js",
    "./recherche": "./dist/recherche.js",
    "./règles": "./dist/règles.js",
    "./tableaux": "./dist/tableaux.js",
    "./variables": "./dist/variables.js",
    "./favoris": "./dist/favoris.js",
    "./libp2p": "./dist/libp2p.js",
    "./profil": "./dist/profil.js",
    "./accès": "./dist/accès.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "nettoyer": "rimraf dist",
    "compiler": "pnpm versioner && pnpm nettoyer && pnpm tsc -p tsconfig.json",
    "test": "pnpm compiler",
    "formatter": "pnpm prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\" && pnpm eslint --ext .js,.ts src",
    "publier": "pnpm compiler && (git commit -a -m 'version' || true) && pnpm stage publish",
    "versioner": "pnpm genversion  --es6 --semi src/version.ts"
  },
  "devDependencies": {
    "@e965/xlsx": "^0.20.3",
    "@eslint/js": "^10.0.1",
    "@libp2p/interface": "^3.4.0",
    "@orbitdb/core-types": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.10",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "aegir": "^48.2.0",
    "eslint": "^10.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-promise": "^7.3.0",
    "libp2p": "^3.5.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "source-map-support": "^0.5.21",
    "typescript": "6",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "genversion": "^3.2.0"
  }
}
